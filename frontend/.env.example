# NEVA orchestrator (chat/live via Gemma). When unset, the app uses built-in
# mock guidance so the UI still works offline.
VITE_API_URL=http://localhost:8000

# Local speech service (Whisper ASR + Piper TTS), from the prebuilt repo's
# server.py. When unset, voice falls back to the browser Web Speech API.
VITE_SPEECH_URL=http://localhost:8001
