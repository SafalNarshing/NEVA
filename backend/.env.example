# ---------------------------------------------------------------------------
# NEVA backend configuration
# Copy to `.env` and fill in. Leave MODEL_API_* blank to run in MOCK mode
# (canned first-aid replies, no external provider needed).
# ---------------------------------------------------------------------------

# App
ENVIRONMENT=development

# Model provider (any OpenAI-compatible /chat/completions endpoint).
# Base URL WITHOUT the trailing /chat/completions. Examples:
#   Groq:      https://api.groq.com/openai/v1
#   HF Router: https://router.huggingface.co/v1
#   Ollama:    http://localhost:11434/v1   (key can be any non-empty string)
#
# "openai" (Groq/HF/Together/OpenAI + Ollama compat) or "ollama" (native).
# Use "ollama" for local reasoning models so thinking can be suppressed.
LLM_PROVIDER=openai

# Local Gemma via Ollama:
#   LLM_PROVIDER=ollama
#   MODEL_API_URL=http://localhost:11434/v1
#   MODEL_API_KEY=ollama
#   MODEL_NAME=gemma4:12b
#   DISABLE_THINKING=true
#
# Gemma via Google's Gemini API (OpenAI-compatible endpoint):
#   LLM_PROVIDER=openai
#   MODEL_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   MODEL_API_KEY=<your Google AI Studio API key>
#   MODEL_NAME=<Gemma model id available on your key, e.g. gemma-3-27b-it>
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=llama-3.1-8b-instant

# Generation. gemma4:12b is a reasoning model — keep MAX_TOKENS generous so the
# spoken answer isn't cut off by internal reasoning tokens.
REQUEST_TIMEOUT=120
TEMPERATURE=0.4
MAX_TOKENS=640

# Ollama context window (tokens). Set this — if unset, Ollama's small default
# truncates the conversation once the RAG protocol block is added and the model
# "forgets" recent turns. 8192 holds system + protocols + several turns.
NUM_CTX=8192

# Reasoning models on Ollama burn tokens "thinking" and can return empty replies.
# Set true for Ollama reasoning models (gemma4:12b) to suppress it via {think:false}.
# Keep FALSE for OpenAI/Groq/HF — they reject this unknown field.
DISABLE_THINKING=false

# Set true only when MODEL_NAME is a vision model (e.g. Gemma 3) and you send
# base64 image data URLs from the frontend.
VISION_ENABLED=false

# CORS — comma-separated origins, or * for all.
# In production set this to your frontend URL, e.g. https://neva.up.railway.app
ALLOWED_ORIGINS=*

# Force mock replies even if credentials are present.
USE_MOCK=false

# --- RAG (WHO / MoHP protocol grounding) -----------------------------------
# Grounds replies in 42 verified WHO Basic Emergency Care (2016) + Nepal MoHP
# (2078) protocol chunks (EN + NE) via bge-m3 embeddings + ChromaDB.
# Enable after:  pip install -r requirements-rag.txt
#                python -m app.rag.build_db --rebuild
RAG_ENABLED=false
RAG_TOP_K=5
RAG_MAX_CHUNKS=4
# True = refuse ("no verified protocol → call 102") when nothing matches.
# False = skip RAG for that turn (keeps casual/follow-up chat flowing).
RAG_STRICT=false
# Optional overrides (must match what build_db.py used):
#   NEVA_EMBED_MODEL=BAAI/bge-m3
#   NEVA_CHROMA_PATH=./app/rag/chroma_db
#   NEVA_RAG_THRESHOLD=0.75

# --- Speech ----------------------------------------------------------------
# ASR + TTS are a SEPARATE local FastAPI service (../speech-service → :8001).
# This orchestrator has no speech deps. Point the frontend at the speech
# service with VITE_SPEECH_URL (default http://localhost:8001).
